# See backend/.env.example and frontend/.env.example for the actual files
# each app reads. This root file is just a reference summary.

# ---- backend/.env ----
# PORT=5000
# MONGODB_URI=mongodb://127.0.0.1:27017/issueflow
# JWT_SECRET=change_this_to_a_long_random_secret
# JWT_EXPIRES_IN=7d
# CLIENT_URL=http://localhost:5173
# CRON_SCHEDULE=*/1 * * * *
# NODE_ENV=development
# MAX_UPLOAD_MB=5

# ---- frontend/.env ----
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
